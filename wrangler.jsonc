{
  // 麻雀大会スコア計算アプリ — ビルド不要の静的サイトを Workers で配信する設定。
  // main（Workerスクリプト）を持たない「静的アセットのみ」の Worker として動作する。
  "name": "doyu-cup",
  "compatibility_date": "2026-09-12",
  "assets": {
    // 公開するファイルの置き場所。除外したいものは .assetsignore に記載する。
    "directory": "./"
  },

  // 独自ドメイン。custom_domain: true にすると、デプロイ時に Cloudflare 側の
  // DNS レコードとカスタムドメインの紐付けが自動で作られる。
  // ゾーン doyu-cup.jp が同じ Cloudflare アカウントにある必要がある。
  "routes": [
    { "pattern": "doyu-cup.jp", "custom_domain": true },
    { "pattern": "www.doyu-cup.jp", "custom_domain": true }
  ]
}
